<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/simpsonsListFragment">

    <fragment
        android:id="@+id/simpsonsListFragment"
        android:name="edu.iesam.simpsonsapp.features.simpsons.presentation.SimpsonsListFragment"
        android:label="Lista">
        <action
            android:id="@+id/action_list_to_detail"
            app:destination="@id/simpsonsDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/simpsonsDetailFragment"
        android:name="edu.iesam.simpsonsapp.features.simpsons.presentation.SimpsonsDetailFragment"
        android:label="Detalle">
        <argument
            android:name="simpson_id"
            app:argType="string" />
    </fragment>

</navigation>